#!/bin/sh
# Evener launcher for the Claude Code plugin.
#
# Resolution order:
#   1. $EVENER_BIN
#   2. <plugin root>/../../core/dist/src/cli.js (monorepo checkout)
#   3. <plugin root>/node_modules/evener/dist/src/cli.js (the plugin's pinned core,
#      installed from npm by Claude Code from package-lock.json)
#   4. a globally installed `evener` that is not this script
#   5. npx -y evener@<plugin version> (npx -y evener when the version is unreadable)
set -u

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
self_path="$self_dir/$(basename -- "$0")"
plugin_root=$(CDPATH= cd -- "$self_dir/.." && pwd)
core_cli="$plugin_root/../../core/dist/src/cli.js"
plugin_cli="$plugin_root/node_modules/evener/dist/src/cli.js"
plugin_json="$plugin_root/.claude-plugin/plugin.json"

if [ -n "${EVENER_BIN:-}" ]; then
  exec "$EVENER_BIN" "$@"
fi

if [ -f "$core_cli" ]; then
  exec node "$core_cli" "$@"
fi

if [ -f "$plugin_cli" ]; then
  exec node "$plugin_cli" "$@"
fi

if global_evener=$(command -v evener 2>/dev/null); then
  case "$global_evener" in
    */*)
      global_path=$(CDPATH= cd -- "$(dirname -- "$global_evener")" 2>/dev/null && pwd)/$(basename -- "$global_evener")
      ;;
    *)
      global_path=$global_evener
      ;;
  esac
  if [ -x "$global_evener" ] && [ "$global_path" != "$self_path" ] && [ ! "$global_path" -ef "$self_path" ]; then
    exec "$global_evener" "$@"
  fi
fi

plugin_version=$(
  node -p '(() => {
    try {
      const value = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).version;
      return typeof value === "string" ? value : "";
    } catch {
      return "";
    }
  })()' "$plugin_json" 2>/dev/null
) || plugin_version=

case "$plugin_version" in
  "" | *[!0-9A-Za-z.+-]*)
    exec npx -y evener "$@"
    ;;
  *)
    exec npx -y "evener@$plugin_version" "$@"
    ;;
esac
