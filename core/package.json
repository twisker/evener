{
  "name": "evener",
  "version": "0.1.0",
  "description": "Route delegated coding tasks to the most cost-effective target harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twisker/evener.git",
    "directory": "core"
  },
  "homepage": "https://github.com/twisker/evener#readme",
  "keywords": [
    "evener",
    "ai",
    "coding-agent",
    "routing",
    "cost",
    "claude-code",
    "codex",
    "dsh",
    "llm"
  ],
  "bin": {
    "evener": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/src",
    "templates",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
