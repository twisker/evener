{
  "name": "evener-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "adapters/*"
  ],
  "scripts": {
    "build": "npm run build -w core",
    "check-versions": "sh scripts/check-versions.sh",
    "test": "npm run check-versions && npm run test -w core && npm run test:adapter",
    "test:adapter": "npm test -w adapters/claude-code"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
